{
  "name": "ejupi-labs-blog",
  "version": "1.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "generate:social": "node scripts/generate-social-previews.mjs",
    "check:social": "node scripts/generate-social-previews.mjs --check",
    "new:case": "node scripts/new-case.mjs",
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "verify:sources": "node scripts/verify-labs-sources.mjs",
    "test": "npm run check:social && npm run build && npm run validate && node --test",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run test:e2e && wrangler deploy --dry-run",
    "dev": "npm run build && wrangler dev",
    "predeploy": "npm run verify:sources",
    "deploy": "npm run check && wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "sharp": "0.35.0",
    "wrangler": "4.113.0"
  },
  "overrides": {
    "sharp": "0.35.0"
  },
  "engines": {
    "node": ">=22"
  }
}
